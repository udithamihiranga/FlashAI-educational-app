# API Configuration
# NVIDIA API key for AI note and flashcard generation
# Get your key from https://build.nvidia.com
NVIDIA_API_KEY=YOUR_API_KEY_HERE

# Base URL for NVIDIA API (NIM endpoints)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model to use (default: Llama 3.1 Nemotron Ultra - optimized for educational content)
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# NVIDIA Build API configuration (recommended - better quality)
# Get your key from https://build.nvidia.com
NVIDIA_BUILD_API_KEY=YOUR_API_KEY_HERE
NVIDIA_BUILD_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BUILD_MODEL=meta/llama-3.1-8b-instruct
# Optional: custom auth header name (default: Authorization)
# NVIDIA_BUILD_AUTH_HEADER=Authorization

# AI Provider selection: 'nvidia' or 'openrouter'
AI_PROVIDER=nvidia

# OpenRouter API key (optional fallback)
# OPENROUTER_API_KEY=YOUR_API_KEY_HERE

# Base URL for OpenRouter API
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model to use with OpenRouter
# OPENROUTER_MODEL=anthropic/claude-3-haiku:beta